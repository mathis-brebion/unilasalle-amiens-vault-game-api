# Copy this file to .env and adjust values for your local setup
DB_HOST=change-me
DB_PORT=3306
DB_NAME=change-me
DB_USERNAME=vault_user
DB_PASSWORD=change-me
SERVER_PORT=8081

# Optional: if set, DB_URL overrides DB_HOST/DB_PORT/DB_NAME above.
# DB_URL=jdbc:mysql://localhost:3306/vault_game

# Keycloak issuer used to validate incoming JWTs.
# Must exactly match the "iss" claim contained in access tokens.
KEYCLOAK_ISSUER_URI=http://localhost:PORT/realms/YOUR_REALM

# Allowed frontend origin(s), comma-separated.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# RAWG API key for game autocomplete/details.
RAWG_API_KEY=change-me
# Optional override for RAWG base URL
# RAWG_API_BASE_URL=https://api.rawg.io/api
